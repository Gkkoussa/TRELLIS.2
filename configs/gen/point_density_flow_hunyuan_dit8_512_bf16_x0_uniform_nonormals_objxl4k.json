{
    "models": {
        "denoiser": {
            "name": "HunyuanPointDensityFlowModel",
            "args": {
                "context_points": 81920,
                "num_latents": 4096,
                "width": 1024,
                "heads": 16,
                "depth": 8,
                "mlp_ratio": 4.0,
                "num_freqs": 8,
                "include_pi": true,
                "qkv_bias": true,
                "qk_norm": true,
                "time_embed_dim": 256,
                "time_factor": 1000.0,
                "query_chunk_size": 4096,
                "training_query_chunk_size": null,
                "use_query_normals": false
            }
        }
    },
    "dataset": {
        "name": "PointDensityMeshDataset",
        "args": {
            "context_points": 81920,
            "query_points": 16384,
            "density_resolution": 512,
            "field_name": "density",
            "density_stats_path": "${POINT_DENSITY_STATS}",
            "min_aesthetic_score": null,
            "deterministic_sampling": false,
            "sampling_seed": 0,
            "include_query_normals": false
        }
    },
    "validation_dataset": {
        "name": "PointDensityMeshDataset",
        "args": {
            "context_points": 81920,
            "query_points": 16384,
            "density_resolution": 512,
            "field_name": "density",
            "density_stats_path": "${POINT_DENSITY_STATS}",
            "min_aesthetic_score": null,
            "deterministic_sampling": true,
            "sampling_seed": 0,
            "include_query_normals": false
        }
    },
    "trainer": {
        "name": "PointDensityFlowTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "num_workers": 8,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0001,
                    "weight_decay": 0.01,
                    "betas": [0.9, 0.95],
                    "eps": 1e-8
                }
            },
            "lr_scheduler": {
                "name": "LinearWarmupLRScheduler",
                "args": {
                    "warmup_steps": 1000
                }
            },
            "ema_rate": [0.9999],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "grad_clip": 1.0,
            "query_loss_weight": 1.0,
            "context_loss_type": "x0",
            "field_name": "density",
            "snapshot_batch_size": 1,
            "snapshot_num_samples": 8,
            "snapshot_steps": 50,
            "i_print": 100,
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "i_ddpcheck": 10000,
            "t_schedule": {
                "name": "uniform",
                "args": {}
            },
            "sigma_min": 1e-5
        }
    }
}
