{
    "models": {
        "denoiser": {
            "name": "SparseUNetDiTFlowModel",
            "args": {
                "in_channels": 6,
                "out_channels": 6,
                "model_channels": [64, 128, 512],
                "num_blocks": [1, 2, 4],
                "block_type": [
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d"
                ],
                "down_block_type": [
                    "SparseResBlockS2C3d",
                    "SparseResBlockS2C3d"
                ],
                "up_block_type": [
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d"
                ],
                "block_args": [
                    {
                        "use_checkpoint": true
                    },
                    {
                        "use_checkpoint": true
                    },
                    {
                        "use_checkpoint": false
                    }
                ],
                "latent_channels": 512,
                "dit_model_channels": 768,
                "dit_num_blocks": 8,
                "dit_num_heads": 12,
                "dit_mlp_ratio": 4.0,
                "pe_mode": "rope",
                "dit_share_mod": true,
                "initialization": "scaled",
                "qk_rms_norm": true,
                "dtype": "bfloat16",
                "dit_use_checkpoint": true,
                "use_fp16": false
            }
        }
    },
    "dataset": {
        "name": "SparseGaussianPatchDataset",
        "args": {
            "resolution": 64,
            "patch_size": 64,
            "min_aesthetic_score": 4.5,
            "max_active_voxels": null,
            "min_patch_active_voxels": 1,
            "max_resample_attempts": 1,
            "max_num_faces": null,
            "attrs": [
                "base_color",
                "emissive"
            ],
            "voxel_root_key": "gaussian_distance_voxel",
            "voxelized_flag_column": "gaussian_distance_voxelized",
            "num_voxels_column": "num_gaussian_distance_voxels",
            "foreground_patch_prob": 1.0,
            "background_value": -1.0,
            "num_read_threads": 4,
            "cond_as_token": false,
            "zero_cond": true
        }
    },
    "trainer": {
        "name": "SparseFlowMatchingTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 16,
            "batch_split": 1,
            "num_workers": 2,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-4,
                    "weight_decay": 0.01,
                    "betas": [0.9, 0.95],
                    "eps": 1e-8
                }
            },
            "ema_rate": [
                0.9999
            ],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "t_schedule": {
                "name": "uniform",
                "args": {}
            },
            "sigma_min": 1e-5,
            "noise_scale": 2.0,
            "skip_startup_snapshot": true,
            "snapshot_batch_size": 1
        }
    }
}
