{
    "models": {
        "denoiser": {
            "name": "SparseStructureFlowModel",
            "args": {
                "resolution": 16,
                "in_channels": 6,
                "out_channels": 6,
                "model_channels": 1536,
                "cond_channels": 3,
                "num_blocks": 30,
                "num_heads": 12,
                "mlp_ratio": 5.3334,
                "pe_mode": "rope",
                "share_mod": true,
                "initialization": "scaled",
                "qk_rms_norm": true,
                "qk_rms_norm_cross": true
            }
        }
    },
    "dataset": {
        "name": "DenseGaussianPatchDataset",
        "args": {
            "resolution": 256,
            "patch_size": 16,
            "min_aesthetic_score": 4.5,
            "max_active_voxels": 4096,
            "max_num_faces": null,
            "attrs": [
                "base_color",
                "emissive"
            ],
            "voxel_root_key": "gaussian_distance_voxel",
            "voxelized_flag_column": "gaussian_distance_voxelized",
            "num_voxels_column": "num_gaussian_distance_voxels",
            "foreground_patch_prob": 0.8,
            "background_value": -1.0,
            "num_read_threads": 4,
            "cond_as_token": true,
            "zero_cond": true
        }
    },
    "trainer": {
        "name": "FlowMatchingTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 2,
            "batch_split": 1,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-4,
                    "weight_decay": 0.01,
                    "betas": [0.9, 0.95],
                    "eps": 1e-8
                }
            },
            "ema_rate": [
                0.9999
            ],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "t_schedule": {
                "name": "uniform",
                "args": {}
            },
            "sigma_min": 1e-5,
            "snapshot_batch_size": 1
        }
    }
}
