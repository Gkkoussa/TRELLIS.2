{
    "models": {
        "encoder": {
            "name": "SparseUnetVaeEncoder",
            "args": {
                "in_channels": 20,
                "model_channels": [64, 128, 256, 512, 1024],
                "latent_channels": 32,
                "num_blocks": [0, 4, 8, 16, 4],
                "block_type": [
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d"
                ],
                "down_block_type": [
                    "SparseResBlockS2C3d",
                    "SparseResBlockS2C3d",
                    "SparseResBlockS2C3d",
                    "SparseResBlockS2C3d"
                ],
                "block_args": [
                    {"use_checkpoint": true},
                    {"use_checkpoint": true},
                    {"use_checkpoint": false},
                    {"use_checkpoint": false},
                    {"use_checkpoint": false}
                ],
                "use_fp16": false
            }
        },
        "decoder": {
            "name": "SparseUnetVaeHierarchicalVertexEdgeDtriContextNoVaeFusionDecoder",
            "args": {
                "out_channels": 2,
                "model_channels": [1024, 512, 256, 128, 64],
                "latent_channels": 32,
                "num_blocks": [4, 16, 8, 4, 0],
                "block_type": [
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d"
                ],
                "up_block_type": [
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d"
                ],
                "block_args": [
                    {"use_checkpoint": false},
                    {"use_checkpoint": false},
                    {"use_checkpoint": false},
                    {"use_checkpoint": true},
                    {"use_checkpoint": true}
                ],
                "use_fp16": false,
                "pred_subdiv": false,
                "pred_vertex_subdiv": true,
                "pred_edge": true,
                "vertex_feature_channels": 512,
                "vertex_num_heads": 4,
                "vertex_mlp_ratio": 4.0,
                "vertex_local_blocks": 1,
                "vertex_use_checkpoint": true,
                "vertex_qk_rms_norm": true,
                "edge_hidden_channels": 512,
                "r512_edge_dtri_threshold": 0.1,
                "r512_vertex_query_threshold": 0.5,
                "r512_edge_context_architecture": "cross_only",
                "r512_edge_context_num_heads": 4,
                "r512_edge_context_use_checkpoint": true,
                "r512_edge_context_qk_rms_norm": true
            }
        }
    },
    "dataset": {
        "name": "MultiResolutionSparseVoxelTriangleFieldDataset",
        "args": {
            "min_aesthetic_score": null,
            "max_active_voxels": 1000000,
            "max_num_faces": null,
            "voxel_root_key": "triangle_field_voxel",
            "voxel_dirname": "triangle_field_voxels",
            "voxelized_flag_column": "triangle_field_voxelized",
            "num_voxels_column": "num_triangle_field_voxels",
            "distance_transform": "minus_one_one",
            "vertex_prediction": true,
            "edge_prediction": true,
            "qem_root": "/nfs/turbo/coe-jjparkcv-medium/gpranav/objxl_4k/qem_edge_collapsed_meshes_{resolution}",
            "vertex_upsample_stages": 4,
            "qem_resolutions": [32, 64, 128, 256, 512],
            "edge_training_resolutions": [512],
            "resolutions": [32, 64, 128, 256, 512],
            "instances_path": "/nfs/turbo/coe-jjparkcv-medium/gpranav/objxl_4k/splits/train_triangle_field_512/instances.txt"
        }
    },
    "trainer": {
        "name": "TriangleFieldVaeTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "num_workers": 2,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.00001,
                    "weight_decay": 0.0
                }
            },
            "lr_scheduler": {
                "name": "LinearWarmupLRScheduler",
                "args": {"warmup_steps": 1000}
            },
            "ema_rate": [],
            "fp16_mode": "amp",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "lambda_kl": 0.000001,
            "lambda_vertex": 1.0,
            "vertex_training_resolutions": [512],
            "vertex_threshold": 0.5,
            "vertex_child_pos_weight_by_stage": {},
            "vertex_finest_loss": "weighted_bce",
            "vertex_snapshot_samples": 4,
            "vertex_snapshot_stage_samples": 1,
            "vertex_snapshot_image_resolution": 256,
            "vertex_snapshot_ssaa": 2,
            "lambda_edge": 1.0,
            "edge_training_resolutions": [512],
            "edge_negative_pairs": 50,
            "edge_nearby_negative_pairs": 25,
            "edge_knn_k": 32,
            "edge_threshold": 0.5,
            "loss_type": "l1",
            "voxel_loss_weight": null,
            "lambda_render": 0.0,
            "debug_nans": true,
            "aux_feature_dropout": {
                "enabled": false,
                "full_prob": 0.5,
                "drop_all_prob": 0.25,
                "drop_group_prob": 0.25,
                "group_drop_prob": 0.5,
                "freeze_decoder_on_drop": true,
                "groups": [
                    "offset_to_v0",
                    "offset_to_v1",
                    "offset_to_v2",
                    "offset_to_centroid",
                    "face_normal",
                    "offset_to_projection"
                ]
            },
            "finetune_ckpt": {
                "encoder": "SET_BY_JOB_SCRIPT",
                "decoder": "SET_BY_JOB_SCRIPT"
            }
        }
    }
}
