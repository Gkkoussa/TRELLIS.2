{
    "models": {
        "encoder": {
            "name": "SparseUnetVaeEncoder",
            "args": {
                "in_channels": 20,
                "model_channels": [64, 128, 256, 512, 1024],
                "latent_channels": 32,
                "num_blocks": [0, 4, 8, 16, 4],
                "block_type": [
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d"
                ],
                "down_block_type": [
                    "SparseResBlockS2C3d",
                    "SparseResBlockS2C3d",
                    "SparseResBlockS2C3d",
                    "SparseResBlockS2C3d"
                ],
                "block_args": [
                    {"use_checkpoint": true},
                    {"use_checkpoint": true},
                    {"use_checkpoint": false},
                    {"use_checkpoint": false},
                    {"use_checkpoint": false}
                ],
                "use_fp16": true
            }
        },
        "decoder": {
            "name": "SparseUnetVaeDecoder",
            "args": {
                "out_channels": 2,
                "model_channels": [1024, 512, 256, 128, 64],
                "latent_channels": 32,
                "num_blocks": [4, 16, 8, 4, 0],
                "block_type": [
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d",
                    "SparseConvNeXtBlock3d"
                ],
                "up_block_type": [
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d",
                    "SparseResBlockC2S3d"
                ],
                "block_args": [
                    {"use_checkpoint": false},
                    {"use_checkpoint": false},
                    {"use_checkpoint": false},
                    {"use_checkpoint": true},
                    {"use_checkpoint": true}
                ],
                "use_fp16": true,
                "pred_subdiv": false
            }
        }
    },
    "dataset": {
        "name": "MultiResolutionZarrSparseVoxelTriangleFieldDataset",
        "args": {
            "index_csv": "/nfs/turbo/coe-jjparkcv-medium/gpranav/objxl_4k/triangle_field_full239k_avgfrom512_v2/manifests/usable/train.csv",
            "resolutions": [32, 64, 128, 256, 512],
            "max_open_shards": 4,
            "max_active_voxels": 1000000,
            "distance_transform": "minus_one_one"
        }
    },
    "validation_dataset": {
        "name": "MultiResolutionZarrSparseVoxelTriangleFieldDataset",
        "data_dir": "{}",
        "args": {
            "index_csv": "/nfs/turbo/coe-jjparkcv-medium/gpranav/objxl_4k/triangle_field_full239k_avgfrom512_v2/manifests/usable/holdout.csv",
            "resolutions": [32, 64, 128, 256, 512],
            "max_open_shards": 2,
            "max_active_voxels": 1000000,
            "distance_transform": "minus_one_one"
        }
    },
    "trainer": {
        "name": "TriangleFieldVaeTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 2,
            "batch_size_per_gpu_by_resolution": {
                "32": 16,
                "64": 16,
                "128": 8,
                "256": 4,
                "512": 2
            },
            "resolution_sampling_weights": {
                "32": 1.0,
                "64": 1.0,
                "128": 1.0,
                "256": 1.0,
                "512": 1.0
            },
            "batch_split": 1,
            "num_workers": 8,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0001,
                    "weight_decay": 0.0
                }
            },
            "lr_scheduler": {
                "name": "LinearWarmupLRScheduler",
                "args": {"warmup_steps": 1000}
            },
            "ema_rate": [0.9999],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {"max_norm": 1.0, "clip_percentile": 95}
            },
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "lambda_kl": 0.000001,
            "loss_type": "l1",
            "sample_balanced_loss": true,
            "voxel_loss_weight": null,
            "lambda_render": 0.0,
            "debug_nans": false,
            "aux_feature_dropout": {"enabled": false}
        }
    }
}
